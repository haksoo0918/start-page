{
  "manifest_version": 3,
  "name": "Startpage Dashboard",
  "version": "1.9.0",
  "description": "Clean & Fast Desktop Browser Start Page Dashboard",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "현재 페이지를 시작화면에 추가"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
